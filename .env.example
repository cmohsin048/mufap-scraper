# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com

# Your project URL (looks like: https://xxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your service role key (from Settings → API → Service Role Key)
# ⚠️ IMPORTANT: Use service_role key, NOT anon key
# ⚠️ WARNING: Keep this secret! Never commit to git!
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Optional: Rate limiting (milliseconds between requests)
RATE_LIMIT_DELAY=1000

# Optional: Batch size for bulk inserts
BATCH_SIZE=50

# NAV collector: auto switches to a persistent browser when Cloudflare challenges HTTP.
# Use browser to start directly in Chrome, or http for unattended fail-fast operation.
MUFAP_TRANSPORT=auto
# Installed browser channel: chrome (falls back to Edge if absent) or msedge.
MUFAP_BROWSER=chrome
